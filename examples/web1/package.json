{
  "name": "@jupyter-widgets/example-web1",
  "version": "8.0.14",
  "private": true,
  "description": "Project that tests the ability to npm install jupyter-js-widgets within an npm project.",
  "license": "BSD-3-Clause",
  "author": "IPython",
  "main": "index.js",
  "scripts": {
    "build": "rspack",
    "build:test": "rspack --config test/rspack.config.js",
    "clean": "rimraf built",
    "test": "npm run test:firefox && npm run test:chrome",
    "test:chrome": "npm run test:default -- --browsers chromium",
    "test:default": "npm run build:test && web-test-runner --playwright",
    "test:firefox": "npm run test:default -- --browsers firefox",
    "test:firefox:headless": "npx playwright install firefox && npm run test:firefox"
  },
  "dependencies": {
    "@jupyter-widgets/base": "^6.0.12",
    "@jupyter-widgets/base-manager": "^1.0.13",
    "@jupyter-widgets/controls": "^5.0.13"
  },
  "devDependencies": {
    "@rspack/cli": "^1.7.12",
    "@rspack/core": "^1.7.12",
    "@web/test-runner": "^1.0.0",
    "@web/test-runner-playwright": "^1.0.0",
    "chai": "^4.0.0",
    "css-loader": "^6.5.1",
    "style-loader": "^3.3.1"
  }
}
