{
  "name": "@jupyter-widgets/base-manager",
  "version": "1.0.13",
  "description": "Jupyter interactive widgets - base manager",
  "repository": {
    "type": "git",
    "url": "https://github.com/jupyter-widgets/ipywidgets.git"
  },
  "license": "BSD-3-Clause",
  "author": "Project Jupyter",
  "main": "lib/index.js",
  "typings": "lib/index.d.ts",
  "files": [
    "lib/**/*.map",
    "lib/**/*.d.ts",
    "lib/**/*.js",
    "css/*.css",
    "src"
  ],
  "scripts": {
    "build": "npm run build:src",
    "build:src": "tsc --build",
    "build:test": "tsc --build test && rspack --config test/rspack.conf.js",
    "clean": "npm run clean:src",
    "clean:src": "rimraf lib && rimraf tsconfig.tsbuildinfo",
    "prepublish": "npm run clean && npm run build",
    "test": "npm run test:unit",
    "test:unit": "npm run test:unit:firefox && npm run test:unit:chrome",
    "test:unit:chrome": "npm run test:unit:default -- --browsers chromium",
    "test:unit:debug": "npm run build:test && web-test-runner test/build/bundle.js --manual --open",
    "test:unit:default": "npm run build:test && web-test-runner test/build/bundle.js --playwright",
    "test:unit:firefox": "npm run test:unit:default -- --browsers firefox",
    "test:unit:firefox:headless": "npx playwright install firefox && npm run test:unit:firefox"
  },
  "dependencies": {
    "@jupyter-widgets/base": "^6.0.12",
    "@jupyterlab/services": "^7.0.0",
    "@lumino/coreutils": "^2.0.0",
    "base64-js": "^1.2.1",
    "sanitize-html": "^2.3"
  },
  "devDependencies": {
    "@rspack/cli": "^1.7.12",
    "@rspack/core": "^1.7.12",
    "@types/base64-js": "^1.2.5",
    "@types/chai": "^4.1.7",
    "@types/chai-as-promised": "^7.1.0",
    "@types/expect.js": "^0.3.29",
    "@types/mocha": "^10.0.0",
    "@types/sanitize-html": "^2.6.0",
    "@types/sinon": "^10.0.2",
    "@types/sinon-chai": "^3.2.2",
    "@web/test-runner": "^1.0.0",
    "@web/test-runner-playwright": "^1.0.0",
    "chai": "^4.0.0",
    "chai-as-promised": "^7.0.0",
    "expect.js": "^0.3.1",
    "npm-run-all": "^4.1.5",
    "rimraf": "^3.0.2",
    "sinon": "^12.0.1",
    "sinon-chai": "^3.3.0",
    "typescript": "~6.0.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
